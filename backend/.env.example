DATABASE_URL=postgresql+psycopg://livlink:livlink@localhost:5432/livlink

# Offline hackathon mode: keyword matching plus deterministic analytics.
# No external AI API or API key is needed for the demo.
AI_USE_SEEDED=true

# Device telemetry uses the in-process mock event bus. No MQTT broker or
# network port is required; the variables remain compatibility placeholders.
MQTT_BROKER_HOST=in-process
MQTT_BROKER_PORT=0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
